{
  "name": "jinri-time-manager",
  "productName": "今日",
  "version": "1.0.0",
  "description": "一个把计划时间、实际专注和每日复盘放在一起的个人时间管理软件。",
  "main": "electron-main.js",
  "author": {
    "name": "ZYP6198",
    "email": "zyp6198@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jinri.timemanager",
    "productName": "今日",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron-main.js",
      "README.md",
      "manifest.webmanifest",
      "sw.js",
      "favicon.svg",
      "icon.svg"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "今日-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
